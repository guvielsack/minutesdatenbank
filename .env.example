# Lokale Entwicklung (optional – Standard: data/minutesdatenbank.db)
# DATABASE_URL=sqlite:///./data/minutesdatenbank.db

# Session-Cookie (Produktion: lange Zufallszeichenkette setzen)
# SESSION_SECRET=

# Erster Admin beim Start, wenn noch kein Benutzer existiert
# (start-minutes-tool.bat setzt lokal: admin / change-me-on-first-deploy)
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=change-me-on-first-deploy
